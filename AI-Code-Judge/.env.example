# ─── Flask ────────────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-long-random-string

# ─── Database ─────────────────────────────────────────────────────────────────
# Development (SQLite)
DATABASE_URL=sqlite:///database/judge.db

# Production (PostgreSQL) — uncomment and fill in when deploying
# DATABASE_URL=postgresql://user:password@localhost:5432/aicj

# ─── AI ───────────────────────────────────────────────────────────────────────
# Supported: openai | anthropic
AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here

# Model to use
AI_MODEL=gpt-4o-mini

# ─── Auto-commit watcher ──────────────────────────────────────────────────────
AUTO_COMMIT=true
AUTO_JUDGE=true
# Milliseconds to wait after last save before committing
COMMIT_DELAY=2000
# Comma-separated paths to watch (defaults to current directory)
WATCH_PATHS=.

# ─── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=20

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Development: leave as * to allow file:// and any Live Server port
CORS_ORIGINS=*

# Production: restrict to your actual domain
# CORS_ORIGINS=https://yourapp.com
